{
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lorvex-eight.vercel.app"
        }
      ],
      "destination": "https://www.lorvex.ma/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lorvex-d-gitalcode-s-projects.vercel.app"
        }
      ],
      "destination": "https://www.lorvex.ma/:path*",
      "permanent": true
    }
  ]
}
