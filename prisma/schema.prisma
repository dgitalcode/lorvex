generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
  ANALYST
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  image         String?
  locale        String     @default("fr")
  currency      String     @default("MAD")
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  passwordChangedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  wishlistItems     WishlistItem[]
  cart              Cart?
  orders            Order[]
  reviews           Review[]
  questions         ProductQuestion[]
  answers           ProductAnswer[]
  supportTickets    SupportTicket[]
  notifications     Notification[]
  compareItems      CompareItem[]
  recentlyViewed    RecentlyViewed[]
  auditLogs         AuditLog[]
  blogPosts         BlogPost[]
  giftCardsOwned    GiftCard[]          @relation("GiftCardOwner")
  assignedTickets   SupportTicket[]     @relation("TicketAssignee")
  customerTags      CustomerTagAssignment[]
  segmentMembers    CustomerSegmentMember[]
  loyalty           LoyaltyAccount?
  referralCodes     ReferralCode[]
  analyticsEvents   AnalyticsEvent[]
  abandonedCarts    AbandonedCartSnapshot[]
  authoredOrderNotes OrderNote[]        @relation("OrderNoteAuthor")
  cmsDocumentVersions CmsDocumentVersion[]
  backupRecords     BackupRecord[]
  personalization   PersonalizationProfile?
  deviceSessions    DeviceSession[]
  loginHistory      LoginHistory[]
  twoFactor         TwoFactorAuth?
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  searchQueries     SearchQuery[]

  @@index([role, status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
// CATALOG
// ═══════════════════════════════════════════════════════════

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum MovementType {
  AUTOMATIC
  MANUAL
  QUARTZ
  SPRING_DRIVE
  SMART
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  story       String?   @db.Text
  logoUrl     String?
  coverUrl    String?
  country     String?
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  seoTitle    String?
  seoDescription String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isFeatured, sortOrder])
}

model Collection {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  coverUrl       String?
  videoUrl       String?
  isLimited      Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  sortOrder      Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  flashSales     FlashSale[]

  @@index([isFeatured, sortOrder])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  parentId    String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  sku              String         @unique
  barcode          String?
  shortDescription String?
  description      String         @db.Text
  brandId          String
  collectionId     String?
  categoryId       String?
  gender           Gender         @default(UNISEX)
  movement         MovementType
  status           ProductStatus  @default(DRAFT)
  basePrice        Decimal        @db.Decimal(12, 2)
  compareAtPrice   Decimal?       @db.Decimal(12, 2)
  costPrice        Decimal?       @db.Decimal(12, 2)
  currency         String         @default("MAD")
  isFeatured       Boolean        @default(false)
  isNewArrival     Boolean        @default(false)
  isBestSeller     Boolean        @default(false)
  isLimitedEdition Boolean        @default(false)
  flashSalePrice   Decimal?       @db.Decimal(12, 2)
  flashSaleEndsAt  DateTime?
  warrantyMonths   Int            @default(24)
  weightGrams      Int?
  metaTitle        String?
  metaDescription  String?        @db.Text
  ogImage          String?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  brand            Brand          @relation(fields: [brandId], references: [id])
  collection       Collection?    @relation(fields: [collectionId], references: [id])
  category         Category?      @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  media            ProductMedia[]
  specifications   ProductSpecification[]
  tags             ProductTag[]
  reviews          Review[]
  questions        ProductQuestion[]
  wishlistItems    WishlistItem[]
  compareItems     CompareItem[]
  recentlyViewed   RecentlyViewed[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  relatedFrom      ProductRelation[] @relation("ProductRelationFrom")
  relatedTo        ProductRelation[] @relation("ProductRelationTo")
  flashSales       FlashSale[]

  @@index([status, publishedAt])
  @@index([brandId, status])
  @@index([collectionId])
  @@index([categoryId])
  @@index([gender, movement])
  @@index([isFeatured, isNewArrival, isBestSeller, isLimitedEdition])
  @@index([basePrice])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  barcode       String?
  name          String
  color         String?
  dialColor     String?
  strapMaterial String?
  caseMaterial  String?
  caseSizeMm    Decimal? @db.Decimal(5, 2)
  waterResistanceM Int?
  price         Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock         Int      @default(0)
  lowStockAt    Int      @default(3)
  isDefault     Boolean  @default(false)
  imageUrl      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryMovement[]

  @@index([productId, isDefault])
  @@index([stock])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  type      MediaType @default(IMAGE)
  url       String
  publicId  String?
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  width     Int?
  height    Int?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

enum MediaType {
  IMAGE
  VIDEO
  SPIN_360
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  group     String
  label     String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, group, sortOrder])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

enum RelationType {
  RELATED
  FREQUENTLY_BOUGHT
  ALTERNATIVE
  UPSELL
}

model ProductRelation {
  id              String       @id @default(cuid())
  productId       String
  relatedId       String
  type            RelationType @default(RELATED)
  sortOrder       Int          @default(0)
  product         Product      @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  related         Product      @relation("ProductRelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  variantId String
  delta     Int
  reason    String
  reference String?
  note      String?
  createdAt DateTime @default(now())
  createdBy String?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// COMMERCE
// ═══════════════════════════════════════════════════════════

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)
  couponCode String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  abandonedSnapshots AbandonedCartSnapshot[]

  @@index([status, updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  BANK_TRANSFER
  WALLET
}

model Order {
  id                String        @id @default(cuid())
  number            String        @unique
  userId            String?
  email             String
  phone             String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(COD)
  currency          String        @default("MAD")
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal       @db.Decimal(12, 2)
  couponCode        String?
  giftCardCode      String?
  shippingMethodId  String?
  notes             String?       @db.Text
  trackingNumber    String?
  trackingUrl       String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  paidAt            DateTime?
  invoiceUrl        String?
  shippingAddressId String?
  billingAddressId  String?
  accessTokenHash     String?       @unique
  idempotencyKeyHash  String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingAddress   Address?      @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress    Address?      @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  items             OrderItem[]
  refunds           Refund[]
  returns           ReturnRequest[]
  statusHistory     OrderStatusHistory[]
  orderNotes        OrderNote[]

  @@index([userId, createdAt])
  @@index([status, paymentStatus])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  name        String
  sku         String
  imageUrl    String?
  unitPrice   Decimal        @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal        @db.Decimal(12, 2)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  refundItems RefundItem[]
  returnItems ReturnItem[]

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  createdBy String?
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  estimatedDays Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  orders        Order[]
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  description     String?
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minOrderAmount  Decimal?   @db.Decimal(12, 2)
  maxDiscount     Decimal?   @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int        @default(0)
  perUserLimit    Int        @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  initialAmount Decimal   @db.Decimal(12, 2)
  balance       Decimal   @db.Decimal(12, 2)
  currency      String    @default("MAD")
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  ownerId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  owner         User?     @relation("GiftCardOwner", fields: [ownerId], references: [id])
}

model TaxRate {
  id        String  @id @default(cuid())
  name      String
  country   String  @default("MA")
  region    String?
  rate      Decimal @db.Decimal(5, 4)
  isActive  Boolean @default(true)
}

model Currency {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  symbol    String
  rateToMad Decimal @db.Decimal(12, 6)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     RefundItem[]
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  reason    String
  status    ReturnStatus @default(REQUESTED)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     ReturnItem[]
}

// ═══════════════════════════════════════════════════════════
// CUSTOMER EXPERIENCE
// ═══════════════════════════════════════════════════════════

model Address {
  id         String   @id @default(cuid())
  userId     String?
  label      String?
  firstName  String
  lastName   String
  phone      String
  company    String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String   @default("MA")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@index([userId, isDefault])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  viewedAt  DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String   @db.Text
  images    String[] @default([])
  isVerified Boolean @default(false)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved, rating])
}

model ProductQuestion {
  id         String          @id @default(cuid())
  productId  String
  userId     String
  question   String          @db.Text
  isApproved Boolean         @default(false)
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    ProductAnswer[]

  @@index([productId, isApproved])
}

model ProductAnswer {
  id         String          @id @default(cuid())
  questionId String
  userId     String
  answer     String          @db.Text
  isOfficial Boolean         @default(false)
  createdAt  DateTime        @default(now())
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String       @id @default(cuid())
  userId       String
  assigneeId   String?
  subject      String
  status       TicketStatus @default(OPEN)
  priority     String       @default("NORMAL")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages     SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String?
  body      String        @db.Text
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ═══════════════════════════════════════════════════════════
// CMS & CONTENT
// ═══════════════════════════════════════════════════════════

model SiteSettings {
  id                 String   @id @default("default")
  siteName           String   @default("LORVEX")
  tagline            String?
  logoUrl            String?
  logoDarkUrl        String?
  faviconUrl         String?
  supportEmail       String?
  supportPhone       String?
  whatsappNumber     String?
  socialInstagram    String?
  socialFacebook     String?
  socialTikTok       String?
  socialYoutube      String?
  defaultLocale      String   @default("fr")
  defaultCurrency    String   @default("MAD")
  enableGuestCheckout Boolean @default(true)
  enableReviews      Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  theme              Json?
  seoDefaults        Json?
  updatedAt          DateTime @updatedAt
}

model AnnouncementBar {
  id        String    @id @default(cuid())
  message   String
  href      String?
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
}

model NavigationMenu {
  id        String           @id @default(cuid())
  key       String           @unique
  label     String
  items     NavigationItem[]
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id       String          @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  href     String?
  imageUrl String?
  sortOrder Int            @default(0)
  isMega   Boolean         @default(false)
  openInNew Boolean        @default(false)
  menu     NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem? @relation("NavTree", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavTree")

  @@index([menuId, sortOrder])
}

model FooterColumn {
  id        String       @id @default(cuid())
  title     String
  sortOrder Int          @default(0)
  links     FooterLink[]
}

model FooterLink {
  id       String       @id @default(cuid())
  columnId String
  label    String
  href     String
  sortOrder Int         @default(0)
  column   FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String
  title     String?
  subtitle  String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  content   Json
  updatedAt DateTime @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  content        Json
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  city      String?
  avatarUrl String?
  rating    Int      @default(5)
  body      String   @db.Text
  isFeatured Boolean @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  content        String    @db.Text
  coverUrl       String?
  authorId       String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User?     @relation(fields: [authorId], references: [id])

  @@index([isPublished, publishedAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  type      String
  format    String?
  width     Int?
  height    Int?
  bytes     Int?
  alt       String?
  folder    String?
  createdAt DateTime @default(now())
  createdBy String?

  @@index([folder, createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SystemHealthCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  latencyMs Int?
  detail    String?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

// ═══════════════════════════════════════════════════════════
// ENTERPRISE ADMIN PLATFORM
// ═══════════════════════════════════════════════════════════

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  category    String
  rolePermissions RolePermission[]

  @@index([category])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model CustomerTag {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  color       String?
  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  id     String      @id @default(cuid())
  userId String
  tagId  String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag    CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
}

model CustomerSegment {
  id          String                  @id @default(cuid())
  name        String
  slug        String                  @unique
  description String?
  rules       Json
  isDynamic   Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  members     CustomerSegmentMember[]
}

model CustomerSegmentMember {
  id        String          @id @default(cuid())
  segmentId String
  userId    String
  segment   CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([segmentId, userId])
  @@index([userId])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String?
  userId     String?
  name       String
  path       String?
  referrer   String?
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CmsDocument {
  id          String              @id @default(cuid())
  key         String              @unique
  type        String
  title       String
  status      String              @default("DRAFT")
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  versions    CmsDocumentVersion[]
}

model CmsDocumentVersion {
  id         String      @id @default(cuid())
  documentId String
  version    Int
  content    Json
  note       String?
  createdBy  String?
  createdAt  DateTime    @default(now())
  document   CmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model MarketingCampaign {
  id          String    @id @default(cuid())
  name        String
  type        String
  status      String
  subject     String?
  body        String?   @db.Text
  audience    Json?
  scheduledAt DateTime?
  sentAt      DateTime?
  stats       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([type, createdAt])
}

model DiscountRule {
  id         String    @id @default(cuid())
  name       String
  type       String
  value      Decimal   @db.Decimal(12, 2)
  conditions Json?
  stackable  Boolean   @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([isActive, startsAt, endsAt])
}

model FlashSale {
  id           String      @id @default(cuid())
  name         String
  productId    String?
  collectionId String?
  salePrice    Decimal?    @db.Decimal(12, 2)
  percentOff   Decimal?    @db.Decimal(5, 2)
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean     @default(true)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@index([productId])
  @@index([collectionId])
}

model PopupCampaign {
  id            String    @id @default(cuid())
  name          String
  content       Json
  trigger       String
  delaySeconds  Int?
  scrollPercent Int?
  pageTargets   Json      @default("[\"ALL\"]")
  localeTarget  String    @default("all")
  deviceTarget  String    @default("ALL")
  audience      String    @default("ALL")
  frequency     String    @default("ONCE_PER_SESSION")
  priority      Int       @default(50)
  imageUrl      String?
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([isActive, priority])
}

model AbandonedCartSnapshot {
  id         String   @id @default(cuid())
  cartId     String?
  email      String?
  userId     String?
  items      Json
  total      Decimal  @db.Decimal(12, 2)
  currency   String
  recovered  Boolean  @default(false)
  remindedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart?    @relation(fields: [cartId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recovered, createdAt])
  @@index([email])
  @@index([userId])
}

model LoyaltyAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  points       Int                  @default(0)
  tier         String               @default("STANDARD")
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  delta     Int
  reason    String
  createdAt DateTime       @default(now())
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model ReferralCode {
  id           String   @id @default(cuid())
  userId       String
  code         String   @unique
  uses         Int      @default(0)
  rewardPoints Int      @default(100)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  body       String   @db.Text
  isInternal Boolean  @default(true)
  authorId   String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User?    @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model RefundItem {
  id          String    @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Decimal   @db.Decimal(12, 2)
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([orderItemId])
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  reason      String?
  return      ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

model BackupRecord {
  id          String    @id @default(cuid())
  filename    String
  path        String
  sizeBytes   Int?
  status      String
  snapshot    Json?
  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  author      User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ScheduledJob {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  cron       String?
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  status     String    @default("IDLE")
  lastError  String?   @db.Text
  meta       Json?

  @@index([status, nextRunAt])
}

// ═══════════════════════════════════════════════════════════
// INTELLIGENCE — PERSONALIZATION / SEARCH / SECURITY
// ═══════════════════════════════════════════════════════════

model PersonalizationProfile {
  id               String   @id @default(cuid())
  userId           String?  @unique
  sessionId        String?  @unique
  favoriteBrandIds String[] @default([])
  favoriteCollectionIds String[] @default([])
  priceMin         Decimal? @db.Decimal(12, 2)
  priceMax         Decimal? @db.Decimal(12, 2)
  affinities       Json?
  lastSeenAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([updatedAt])
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  normalized String
  userId    String?
  sessionId String?
  resultCount Int    @default(0)
  clickedProductId String?
  source    String   @default("overlay")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([normalized, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model SearchSynonym {
  id        String   @id @default(cuid())
  term      String
  synonym   String
  locale    String   @default("fr")
  createdAt DateTime @default(now())

  @@unique([term, synonym, locale])
  @@index([term, locale])
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  deviceLabel  String?
  userAgent    String?
  ip           String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String[] @default([])
  enabledAt   DateTime?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SuspiciousActivity {
  id        String   @id @default(cuid())
  userId    String?
  ip        String?
  type      String
  detail    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key, windowStart])
}
