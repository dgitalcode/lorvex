# Public site origin (canonicals, sitemap, robots, email links)
# Production must be https://www.lorvex.ma — never the Vercel *.vercel.app host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lakebase Postgres (Neon). Use the pooled URL for the app.
# Use DATABASE_URL_UNPOOLED for Prisma migrate, dumps, and session features.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Backup object storage (S3 or Cloudflare R2)
BACKUP_STORAGE_PROVIDER=s3
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_FORCE_PATH_STYLE=true
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=

# 32-byte key as 64 hex characters. Do not commit a real value.
BACKUP_ENCRYPTION_KEY=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
BACKUP_CRON_SECRET=
